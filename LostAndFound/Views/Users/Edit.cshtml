@model LostAndFound.Models.EditProfileViewModel
@{
    ViewData["Title"] = "تعديل بياناتي";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h4 class="mb-4"><i class="fas fa-user-edit me-2 text-warning"></i>تعديل بياناتي</h4>

                        <form asp-controller="Users" asp-action="Edit" method="post" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="mb-3 text-center">
                                @if (!string.IsNullOrEmpty(Model.CurrentAvatarBase64))
                                {
                                    <img src="@Model.CurrentAvatarBase64" style="width:90px;height:90px;border-radius:50%;object-fit:cover;" />
                                }
                                else
                                {
                                    <div style="width:90px;height:90px;border-radius:50%;background:#fef3c7;display:flex;align-items:center;justify-content:center;margin:0 auto;">
                                        <i class="fas fa-user fa-2x" style="color:#d97706"></i>
                                    </div>
                                }
                            </div>

                            <div class="mb-3">
                                <label asp-for="AvatarFile" class="form-label"></label>
                                <input asp-for="AvatarFile" type="file" class="form-control" accept="image/*" />
                            </div>

                            <div class="mb-3">
                                <label asp-for="FullName" class="form-label"></label>
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Phone" class="form-label"></label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="City" class="form-label"></label>
                                <select asp-for="City" class="form-select" asp-items="Html.GetEnumSelectList<LostAndFound.Enums.City>()">
                                    <option value="">-- اختاري المحافظة --</option>
                                </select>
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>
                            <hr />
                            <h6 class="mb-3"><i class="fas fa-user-shield me-1 text-warning"></i>إعدادات الخصوصية</h6>

                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" asp-for="ShowPhone" />
                                <label class="form-check-label" asp-for="ShowPhone"></label>
                            </div>

                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" asp-for="ShowEmail" />
                                <label class="form-check-label" asp-for="ShowEmail"></label>
                            </div>

                            <div class="d-flex gap-2 mt-4">
                                <button type="submit" class="btn btn-warning"><i class="fas fa-save me-1"></i>حفظ التعديلات</button>
                                <a asp-controller="Users" asp-action="Profile" class="btn btn-outline-secondary">إلغاء</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

